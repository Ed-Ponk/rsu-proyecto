# ============================================================================
# Variables para ejecutar el proyecto RSU con Docker (docker compose).
#
#   1. Copie este archivo como ".env"  (cp .env.docker.example .env)
#   2. Cambie las contraseñas marcadas con CAMBIAR_... por contraseñas propias.
#   3. Ejecute:  docker compose up -d
#
# Este archivo NO contiene contraseñas reales. El ".env" que usted cree no se sube a
# git ni entra en la imagen (está en .gitignore y .dockerignore).
# ============================================================================

# --- Imagen publicada en Docker Hub y puertos de la computadora --------------
RSU_IMAGE=pieroramirezusat/rsu-municipal:latest
WEB_PORT=8080            # Aplicación:  http://localhost:8080
PMA_PORT=8081            # phpMyAdmin:  http://localhost:8081

# --- Aplicación ---------------------------------------------------------------
APP_URL=http://localhost:8080
# Si se deja vacía, el contenedor genera una APP_KEY y la guarda en un volumen.
APP_KEY=
TZ=America/Lima
# false permite iniciar sesión por http desde cualquier dirección (uso local o demostración).
# Si se coloca HTTPS delante del proxy, cambiar a true.
SESSION_SECURE_COOKIE=false

# --- Administrador inicial (contraseña fuerte: 10+ caracteres, mayúsculas, minúsculas y números)
ADMIN_EMAIL=admin@rsu.local
ADMIN_PASSWORD=CAMBIAR_CLAVE_ADMIN

# true = además de los catálogos, carga datos de ejemplo (zonas, vehículos, personal, grupos).
SEED_DEMO=true

# --- Base de datos MySQL -------------------------------------------------------
DB_DATABASE=rsu_proyecto
DB_USERNAME=rsu
DB_PASSWORD=CAMBIAR_CLAVE_BD
MYSQL_ROOT_PASSWORD=CAMBIAR_CLAVE_ROOT

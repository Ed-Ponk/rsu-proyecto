* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Scripts y archivos de Docker: siempre con saltos de línea de Linux (si no, el contenedor falla con "exec format error").
*.sh text eol=lf
Dockerfile text eol=lf
docker/** text eol=lf
